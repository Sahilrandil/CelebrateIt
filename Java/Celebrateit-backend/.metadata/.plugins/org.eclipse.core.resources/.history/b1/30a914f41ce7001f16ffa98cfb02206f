package com.celebrateit.service;

import java.util.List;


import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.stereotype.Service;

import com.celebrateit.dao.ContactDao;
import com.celebrateit.dao.FeedbackDao;
import com.celebrateit.dto.ContactDTO;
import com.celebrateit.dto.FeedbackResponseDTO;
import com.celebrateit.pojo.Contact;
import com.celebrateit.pojo.Feedback;



@Service

public class FeedbackServiceImpl implements FeedbackService {

	@Autowired
    private FeedbackDao feedbackDao;
	
	 public Feedback addFeedback(Feedback feedback) {
	        return feedbackDao.save(feedback);
	    }
	 
	// Get Feedback by ID
	    public Feedback getFeedbackById(Integer feedbackId) {
	        return feedbackDao.findById(feedbackId)
	                .orElseThrow(() -> new RuntimeException("Feedback not found with ID: " + feedbackId));
	    }
	
	
    
}