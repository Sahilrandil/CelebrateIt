package com.celebrateit.service;

import org.modelmapper.ModelMapper;
import org.springframework.stereotype.Service;
import org.springframework.transaction.annotation.Transactional;

import com.celebrateit.dao.BookingsDao;
import com.celebrateit.dao.UserDao;
import com.celebrateit.dao.ServicesDao;
import com.celebrateit.dao.CategoriesDao;
import com.celebrateit.dto.BookingsRequestDTO;
import com.celebrateit.pojo.Bookings;
import com.celebrateit.pojo.Users;
import com.celebrateit.pojo.Services;
import com.celebrateit.pojo.Categories;

import lombok.RequiredArgsConstructor;
import lombok.extern.slf4j.Slf4j;

@Service
@Transactional
@RequiredArgsConstructor
@Slf4j // Enables logging
public class BookingsServiceImpl implements BookingsService {

    private final BookingsDao bookingsDao;
    private final UserDao userDao;
    private final ServiceDao servicesDao;
    private final CategoryDao categoriesDao;
    private final ModelMapper modelMapper;

    @Override
    public int addBooking(BookingsRequestDTO dto) {
        try {
            // Fetching User
            Users user = userDao.findById(dto.getUserid())
                    .orElseThrow(() -> new RuntimeException("User not found"));

            // Fetching Service
            Services service = serviceDao.findById(dto.getServiceid())
                    .orElseThrow(() -> new RuntimeException("Service not found"));

            // Fetching Category
            Categories category = categoryDao.findById(dto.getCategorieid())
                    .orElseThrow(() -> new RuntimeException("Category not found"));

            // Mapping DTO to Entity
            Bookings booking = modelMapper.map(dto, Bookings.class);
            
            // Setting foreign keys manually to avoid mapping issues
            booking.setUser(user);
            booking.setService(service);
            booking.setCategory(category);

            // Saving to DB
            bookingsDao.save(booking);

            return booking.getBookingid();
        } catch (Exception e) {
            log.error("Error while adding booking: {}", e.getMessage(), e);
            return -1;
        }
    }
}
