package com.celebrateit.mapper;


import com.celebrateit.dto.BookingsDto;
import com.celebrateit.pojo.Bookings;
import org.modelmapper.ModelMapper;
import org.springframework.stereotype.Component;

@Component
public class BookingsMapper {

    private final ModelMapper modelMapper = new ModelMapper();

    public BookingsDto toDto(Bookings bookings) {
        return modelMapper.map(bookings, BookingsDto.class);
    }

    public Bookings toEntity(BookingsDto bookingDto) {
        return modelMapper.map(bookingDto, Bookings.class);
    }
}

